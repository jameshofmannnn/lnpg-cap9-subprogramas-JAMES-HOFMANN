# Versão Modularizado do Sistemas de Vendas


def ler_produto():
    produto = input("Produto: ")
    return produto


def ler_quantidade():
    quantidade = int(input("Quantidade: "))
    return quantidade


def ler_preco():
    preco = float(input("Preço unitário: R$ "))
    return preco


def calcular_subtotal(quantidade, preco):
    subtotal = quantidade * preco
    return subtotal


def calcular_desconto(subtotal):

    if subtotal > 500:
        return subtotal * 0.10

    elif subtotal > 200:
        return subtotal * 0.05

    else:
        return 0



def calcular_total(subtotal, desconto):
    total = subtotal - desconto
    return total


def imprimir_cupom(
        produto,
        quantidade,
        preco,
        subtotal,
        desconto,
        total
):

    print("\n===== CUPOM =====")

    print("Produto:", produto)

    print("Quantidade:", quantidade)

    print("Preço unitário: R$", preco)

    print("Subtotal: R$", subtotal)

    print("Desconto: R$", desconto)

    print("Total final: R$", total)





print("===== SISTEMA DE VENDAS =====")

produto = ler_produto()

quantidade = ler_quantidade()

preco = ler_preco()

subtotal = calcular_subtotal(quantidade, preco)

desconto = calcular_desconto(subtotal)

total = calcular_total(subtotal, desconto)

imprimir_cupom(
    produto,
    quantidade,
    preco,
    subtotal,
    desconto,
    total
)

