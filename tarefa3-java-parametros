public class PassagemPorValor {

    public static void alterarNumero(int x) {

        System.out.println("\nDentro do método:");

        System.out.println("Valor recebido: " + x);

        x = 100;

        System.out.println("Valor após alteração: " + x);
    }


    public static void main(String[] args) {

        int numero = 10;

        System.out.println("Antes da chamada:");
        System.out.println("numero = " + numero);

        
        alterarNumero(numero);

        System.out.println("\nDepois da chamada:");
        System.out.println("numero = " + numero);
    }
}